<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/Styles.uss?fileID=7433441132597879392&amp;guid=4c19fc2dc5c614548a2798c700b1dc05&amp;type=3#Styles" />
    <ui:VisualElement name="Pause" style="flex-grow: 1; align-items: center; justify-content: center; background-color: rgba(0, 0, 0, 0.36); visibility: hidden; position: absolute; top: 0; right: 0; left: 0; bottom: 0;">
        <ui:VisualElement style="flex-grow: 1; position: absolute; height: 502px; width: 842px; background-color: rgba(11, 26, 26, 0.65); align-items: center; border-left-color: rgba(183, 183, 183, 0.47); border-right-color: rgba(183, 183, 183, 0.47); border-top-color: rgba(183, 183, 183, 0.47); border-bottom-color: rgba(183, 183, 183, 0.47); border-top-left-radius: 14px; border-top-right-radius: 14px; border-bottom-right-radius: 14px; border-bottom-left-radius: 14px; border-top-width: 6px; border-right-width: 6px; border-bottom-width: 6px; border-left-width: 6px;">
            <ui:Label text="PAUSED" style="color: rgba(106, 106, 106, 0.69); -unity-font-definition: url(&quot;project://database/Packages/com.unity.render-pipelines.core/Runtime/Debugging/Prefabs/Fonts/PerfectDOSVGA437.ttf?fileID=12800000&amp;guid=74a5091d8707f334b9a5c31ef71a64ba&amp;type=3#PerfectDOSVGA437&quot;); font-size: 71px; top: 10px; -unity-text-outline-color: rgb(255, 255, 255); -unity-text-outline-width: 1px;" />
            <ui:VisualElement name="ButtonContainer" style="flex-grow: 1; top: -9px;">
                <ui:Button text="Resume" name="ResumeButton" class="button" />
                <ui:Button text="Settings" name="SettingsButton" class="button" />
                <ui:Button text="Quit" name="QuitButton" class="button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="Settings" style="flex-grow: 1; align-items: center; justify-content: center; background-color: rgba(0, 0, 0, 0.36); visibility: hidden; position: absolute; top: 0; right: 0; left: 0; bottom: 0;">
        <ui:VisualElement style="flex-grow: 1; position: absolute; height: 502px; width: 842px; background-color: rgba(11, 26, 26, 0.65); align-items: center; border-left-color: rgba(183, 183, 183, 0.47); border-right-color: rgba(183, 183, 183, 0.47); border-top-color: rgba(183, 183, 183, 0.47); border-bottom-color: rgba(183, 183, 183, 0.47); border-top-left-radius: 14px; border-top-right-radius: 14px; border-bottom-right-radius: 14px; border-bottom-left-radius: 14px; border-top-width: 6px; border-right-width: 6px; border-bottom-width: 6px; border-left-width: 6px;">
            <ui:Label text="SETTINGS" style="color: rgba(106, 106, 106, 0.69); -unity-font-definition: url(&quot;project://database/Packages/com.unity.render-pipelines.core/Runtime/Debugging/Prefabs/Fonts/PerfectDOSVGA437.ttf?fileID=12800000&amp;guid=74a5091d8707f334b9a5c31ef71a64ba&amp;type=3#PerfectDOSVGA437&quot;); font-size: 71px; top: 10px; -unity-text-outline-color: rgb(255, 255, 255); -unity-text-outline-width: 1px;" />
            <ui:VisualElement name="SliderContainer" style="flex-grow: 1; top: 14px; width: 554px;">
                <ui:Slider label="MUSIC VOLUME" value="50" high-value="100" name="MusicSlider" show-input-field="true" fill="true" class="slider" />
            </ui:VisualElement>
            <ui:Button text="Back" name="SettingsBackButton" class="exitButton" style="bottom: 15px;" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="VisualUI" style="flex-grow: 1; position: absolute; top: 0%; right: 0%; left: 0%; bottom: 0%; display: flex; background-image: none; visibility: visible;">
        <ui:VisualElement style="flex-grow: 1; position: absolute; top: 0%; left: 0%; right: 0%; bottom: 0%; align-items: center;">
            <ui:VisualElement name="Arrow" style="flex-grow: 1; width: 134px; position: absolute; bottom: 70px; top: 866px; background-image: url(&quot;project://database/Assets/UI%20Toolkit/Icons/arrow.png?fileID=2800000&amp;guid=b54bcec4a6603f545b646b5d4d28d9e7&amp;type=3#arrow&quot;); background-color: rgba(55, 55, 55, 0); -unity-background-scale-mode: scale-to-fit; opacity: 0.29; visibility: visible;" />
            <ui:VisualElement style="flex-grow: 1; left: 28px; right: 1456px; position: absolute; height: 56px; top: 630px; align-items: center; justify-content: center;">
                <ui:ProgressBar value="100" name="ChargerProgress" style="width: 429px;" />
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 1; bottom: 223px; top: 820px; position: absolute; align-items: center; justify-content: center; left: 40%; right: 40%;">
                <ui:ProgressBar value="22" name="RepairProgress" style="width: 367px; background-color: rgba(255, 255, 255, 0); visibility: hidden;" />
            </ui:VisualElement>
            <ui:Label text="Hold &quot;E&quot; to Repair" name="ETip" class="tip" style="visibility: hidden;" />
            <ui:Label text="Hold &quot;SPACE&quot; to Charge" name="SpaceTip" class="tip" style="visibility: hidden;" />
            <ui:VisualElement style="flex-grow: 1; position: absolute; top: 79px; left: 530px; right: 530px; bottom: 918px;">
                <ui:ProgressBar value="22" name="MonsterHealth" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="GameOver" style="flex-grow: 1; align-items: center; justify-content: center; background-color: rgba(0, 0, 0, 0.36); visibility: hidden; position: absolute; top: 0; right: 0; left: 0; bottom: 0;">
        <ui:VisualElement style="flex-grow: 1; position: absolute; height: 502px; width: 842px; background-color: rgba(11, 26, 26, 0.65); align-items: center; border-left-color: rgba(183, 183, 183, 0.47); border-right-color: rgba(183, 183, 183, 0.47); border-top-color: rgba(183, 183, 183, 0.47); border-bottom-color: rgba(183, 183, 183, 0.47); border-top-left-radius: 14px; border-top-right-radius: 14px; border-bottom-right-radius: 14px; border-bottom-left-radius: 14px; border-top-width: 6px; border-right-width: 6px; border-bottom-width: 6px; border-left-width: 6px;">
